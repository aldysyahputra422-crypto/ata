# Copy to .env.local and fill in. Never commit real values. See docs/DEPLOY.md.

# Supabase (free dev/demo project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=

# Server secrets
KEY_ENCRYPTION_SECRET=
CRON_SECRET=

# Demo profile (PRD Lampiran D). Demo paths exist only when this is exactly "true".
DEMO_MODE=true

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Radar extraction. 0 = seed data + rules only, no paid calls.
EXTRACTION_DAILY_BUDGET=0
EXTRACTION_PROVIDER=
EXTRACTION_API_KEY=

# Optional, only when Meta Business Discovery is set up
META_APP_ID=
META_APP_SECRET=
META_IG_USER_ID=
META_ACCESS_TOKEN=

ADMIN_BOOTSTRAP_EMAILS=
